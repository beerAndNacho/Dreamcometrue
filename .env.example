# 1 = synthetic data, separate SQLite DB. 0 = real data only.
DEMO_MODE=0
FRED_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
# Blank uses the built-in monthly cycle index preset (A03/B03, DT_1C8015). Custom URL query optional; see README.
KOSIS_LEADING_QUERY=
KOSIS_COINCIDENT_QUERY=
# Used by local Python. Docker Compose supplies PostgreSQL automatically.
DATABASE_URL=sqlite:///./data/invest.db
HISTORY_START=1995-01-01
AUTO_COLLECT=0
COLLECT_HOUR_KST=8
# Optional: set at least 12 characters. Otherwise generated in data/settings/<mode>/admin-password.txt.
ADMIN_PASSWORD=
# Persistent local directory; contains encrypted API settings and encryption key.
SETTINGS_DIR=./data/settings
# Local only by default. Hosted mode must sit behind HTTPS ingress.
HOSTED_MODE=0
# Set only if using a custom HTTPS domain, otherwise Render provides its hostname.
PUBLIC_ORIGIN=

# Optional read-only Korean market and financial data
KIS_APP_KEY=
KIS_APP_SECRET=
DART_API_KEY=

# Optional AI: off by default. Set exact account-supported model IDs in admin.
AI_PROVIDER=off
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_DAILY_LIMIT=3
AI_MAX_OUTPUT=1200
BLS_AUTO_REFRESH=0

# Optional private Telegram notifications. Off until explicitly configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ENABLED=0
ALERT_DAILY=1
ALERT_HOUR_KST=9
ALERT_RISK=1
ALERT_FLOW=1
ALERT_CALENDAR=1
ALERT_DIVIDEND=1
ALERT_PRICE_RULES=
