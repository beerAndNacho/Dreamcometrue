# 1 = synthetic data, separate SQLite DB. 0 = real data only.
DEMO_MODE=0
FRED_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
# KOSIS API URL builder query string (without apiKey); see README.
KOSIS_LEADING_QUERY=
KOSIS_COINCIDENT_QUERY=
# Used by local Python. Docker Compose supplies PostgreSQL automatically.
DATABASE_URL=sqlite:///./data/invest.db
HISTORY_START=1995-01-01
AUTO_COLLECT=0
COLLECT_HOUR_KST=8
# Optional: set at least 12 characters. Otherwise generated in data/settings/<mode>/admin-password.txt.
ADMIN_PASSWORD=
# Persistent local directory; contains encrypted API settings and encryption key.
SETTINGS_DIR=./data/settings
# Local only by default. Hosted mode must sit behind HTTPS ingress.
HOSTED_MODE=0
# Set only if using a custom HTTPS domain, otherwise Render provides its hostname.
PUBLIC_ORIGIN=

# Optional read-only Korean market and financial data
KIS_APP_KEY=
KIS_APP_SECRET=
DART_API_KEY=
